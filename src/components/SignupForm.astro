---
// The reading group sign-up. Posts straight into the Google Form configured in src/data/site.ts,
// so responses land in its spreadsheet. With JavaScript, the post happens in the background and
// the visitor lands on /thanks/. Without it, the browser posts normally and Google shows its own
// confirmation page. Either way the response is recorded.
import { site } from '../data/site';
const { form, organizer } = site;
const f = form.fields;
---

<form id="sign-up" class="section" method="POST" action={form.formAction} data-signup>
  <div class="section-head">
    <h2>Sign up</h2>
  </div>
  <p class="note">
    Filling this in doesn't commit you to anything. Or use the <a href={form.formUrl} target="_blank" rel="noopener">Google Form</a>; it's the same one.
  </p>
  <div class="form-grid">
    <label>
      <span class="label">Name</span>
      <input class="field" type="text" name={f.name} autocomplete="name" required />
    </label>
    <label>
      <span class="label">Dartmouth email</span>
      <input class="field" type="email" name={f.email} autocomplete="email" placeholder="you@dartmouth.edu" required />
    </label>
    <label class="wide">
      <span class="label">Why are you interested in AI safety?</span>
      <textarea class="field" name={f.why} rows="3" placeholder="A few sentences." required></textarea>
    </label>
    <fieldset class="wide checks">
      <legend class="label">Which Monday times could you make? Check all that work.</legend>
      {form.timeOptions.map((opt) => (
        <label class="check">
          <input type="checkbox" name={f.times} value={opt} />
          <span>{opt}</span>
        </label>
      ))}
      <span class="check-error" hidden>Pick at least one, even if it's the last one.</span>
    </fieldset>
    <label class="wide">
      <span class="label">Anyone else who might be interested? Optional.</span>
      <textarea class="field" name={f.referrals} rows="2" placeholder="Names and emails, if you have them."></textarea>
    </label>
  </div>
  <div class="actions" style="padding-top: 8px;">
    <button class="button primary" type="submit">Sign up&nbsp;→</button>
    <a href={site.bookingUrl}>Or meet with {organizer.short} first</a>
  </div>
</form>

<script>
  const form = document.querySelector('form[data-signup]') as HTMLFormElement | null;
  if (form) {
    const button = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const checks = form.querySelector('.checks') as HTMLElement;
    const checkError = form.querySelector('.check-error') as HTMLElement;

    form.addEventListener('submit', (e) => {
      const anyChecked = form.querySelectorAll('.checks input:checked').length > 0;
      checkError.hidden = anyChecked;
      if (!anyChecked) {
        e.preventDefault();
        checks.scrollIntoView({ block: 'center', behavior: 'smooth' });
        return;
      }
      if (!window.fetch) return; // plain POST; Google shows its confirmation page
      e.preventDefault();
      button.disabled = true;
      button.textContent = 'Sending…';
      // Google Forms doesn't send CORS headers, so the response is opaque. That's fine: a
      // successful request is recorded, and network failure throws and falls back to a plain POST.
      fetch(form.action, { method: 'POST', mode: 'no-cors', body: new URLSearchParams(new FormData(form) as any) })
        .then(() => { window.location.href = '/thanks/'; })
        .catch(() => { form.submit(); });
    });

    form.querySelectorAll('.checks input').forEach((el) => {
      el.addEventListener('change', () => { checkError.hidden = true; });
    });
  }
</script>
