---
import type { Resource } from '../data/resources';

interface Props { item: Resource }
const { item } = Astro.props;
---

<div class="row res">
  <span class="head">
    <a class="title" href={item.href} target="_blank" rel="noopener">{item.title}</a>
    <span class="source">{item.source}</span>
  </span>
  <span class="desc">
    {item.blurb}
    {item.also && <> <a href={item.also.href} target="_blank" rel="noopener">{item.also.label}&nbsp;→</a></>}
  </span>
</div>
