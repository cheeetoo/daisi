---
import Base from '../layouts/Base.astro';
import InterestForm from '../components/InterestForm.astro';
import { site } from '../data/site';
---

<Base title="Get involved" active="/get-involved/">
  <section class="page-title">
    <h1>Get involved</h1>
    <p class="lede">
      The main thing we run is a [X]-week reading group each term. Expressing interest takes a minute
      and isn't an application. Everything else is drop-in.
    </p>
  </section>

  <InterestForm />

  <section class="section">
    <div class="section-head"><h2>The {site.term} reading group</h2></div>
    <div class="list">
      <div class="row kv"><span class="k sc">when</span><span class="v">[Weekday]s, [time], starting [date]</span></div>
      <div class="row kv"><span class="k sc">where</span><span class="v">[Location], with [dinner]</span></div>
      <div class="row kv"><span class="k sc">length</span><span class="v">[X] weeks, one session a week</span></div>
      <div class="row kv"><span class="k sc">commitment</span><span class="v">About 1h45 a week, including roughly an hour of reading</span></div>
      <div class="row kv"><span class="k sc">who</span><span class="v">Anyone at Dartmouth. No prerequisites; groups mix years and majors</span></div>
      <div class="row kv"><span class="k sc">curriculum</span><span class="v">[Adapted from BlueDot's AI Safety Fundamentals]. <a href="/resources/">See the syllabus&nbsp;→</a></span></div>
      <div class="row kv"><span class="k sc">cost</span><span class="v">Free</span></div>
    </div>
    <p class="note">
      Each week you do the readings, then meet in a group of [6 to 8] with a facilitator to argue
      about them. By the end you should be able to follow the current debates in the field, and know
      where you'd want to go next. If more people want in than we have places, we'll [run a second
      group / prioritise by year].
    </p>
  </section>

  <section class="section">
    <div class="section-head"><h2>Other ways in</h2></div>
    <div class="list">
      <a class="row" href={site.calendarUrl}>
        <span class="name">Come to a talk</span>
        <span class="desc">Speaker events are open to everyone at Dartmouth. Just turn up.</span>
        <span class="meta">Next: [date]</span>
      </a>
      <a class="row" href={site.chatUrl}>
        <span class="name">Chat with us</span>
        <span class="desc">
          Coffee with an organizer. Useful if you're curious but not sure where you'd fit, or just
          want to argue about it.
        </span>
        <span class="meta link">Book a time&nbsp;→</span>
      </a>
      <a class="row" href={`mailto:${site.email}`} data-copy-email>
        <span class="name">Help run things</span>
        <span class="desc">
          We're new and small. If you'd like to facilitate, organise events, or build things, we'd
          like to hear from you.
        </span>
        <span class="meta link">Email us&nbsp;→</span>
      </a>
    </div>
  </section>
</Base>
