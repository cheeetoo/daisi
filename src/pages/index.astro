---
import Base from '../layouts/Base.astro';
// import ResourceRow from '../components/ResourceRow.astro';
import SignupForm from '../components/SignupForm.astro';
import { site } from '../data/site';
// import { reading } from '../data/resources';
const { group } = site;
---

<Base>
  <section class="hero">
    <h1>Dartmouth's student organization dedicated to <span class="accent">reducing catastrophic risks from AI</span>.</h1>
    <p class="lede">
      Reducing risks from advanced AI may be one of the most important problems of our time. We
      run an introductory <a href="/#reading-group">reading group</a> on why AI safety matters and what we can do about it. Open to
      anyone regardless of background, undergrad or grad students.
    </p>
    <div class="actions">
      <a class="button primary" href="/#reading-group">Sign up for the reading group&nbsp;→</a>
      <a class="button" href={site.groupMeUrl}>Join the GroupMe</a>
      <a href={site.bookingUrl}>Chat with us</a>
    </div>
  </section>

  <section class="section" id="reading-group">
    <div class="section-head"><h2>Reading group</h2></div>
    <p class="prose-p">
      Monday evenings, 90 minutes/week for 6 weeks, starting week five of the term. There is no
      preparation required since we read together, and will have good food for dinner. Open to anyone
      at Dartmouth regardless of background, undergrad or grad.
    </p>
    <p class="prose-p">
      Sign-ups close {group.signupsClose}. Time and place will be announced in the GroupMe.
    </p>
    <details class="more">
      <summary>Rough weekly topics (subject to change)</summary>
      <div class="list">
        {group.curriculum.map((w) => (
          <div class="row kv">
            <span class="k">Week {w.week}</span>
            <span class="v">{w.title}{w.note && <span class="aside"> ({w.note})</span>}</span>
          </div>
        ))}
      </div>
    </details>
  </section>

  <SignupForm />

  {/* Useful reading: hidden for now. Restore the imports above to bring it back.
  <section class="section" id="reading">
    <div class="section-head"><h2>Useful reading</h2></div>
    <div class="list">
      {reading.map((item) => <ResourceRow item={item} />)}
    </div>
  </section>
  */}
</Base>
