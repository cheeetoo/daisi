---
import Base from '../layouts/Base.astro';
import ResourceRow from '../components/ResourceRow.astro';
import { site } from '../data/site';
import { startHere } from '../data/resources';
---

<Base>
  <section class="hero">
    <h1>{site.tagline}</h1>
    <p class="lede">
      We think advanced AI may be one of the most consequential technologies of this century, and
      that whether it goes well is still an open question. We run a reading group, host speakers, and
      help students find their way into the field. No prerequisites, and everyone at Dartmouth is
      welcome.
    </p>
    <div class="actions">
      <a class="button" href="/get-involved/#express-interest">Express interest&nbsp;→</a>
      <a href={site.chatUrl}>Chat with us</a>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>What we run</h2></div>
    <div class="list">
      <a class="row" href="/get-involved/">
        <span class="name">Reading group</span>
        <span class="desc">
          [X] weeks, one evening a week over [dinner]. A guided tour of the core ideas in AI safety,
          in groups of [6 to 8]. No prerequisites.
        </span>
        <span class="meta">{site.term}<br />[weekday]s, [time]</span>
      </a>
      <a class="row" href={site.calendarUrl}>
        <span class="name">Speaker events</span>
        <span class="desc">
          Talks and Q&amp;As with people working on AI safety, a few times a term. Open to everyone,
          no sign-up.
        </span>
        <span class="meta">Next: [date]</span>
      </a>
      <a class="row" href={site.chatUrl}>
        <span class="name">Chat with us</span>
        <span class="desc">Not sure whether any of this is for you? Get coffee with one of us. No agenda.</span>
        <span class="meta">Any time</span>
      </a>
    </div>
  </section>

  <section class="two">
    <div>
      <h3>Who it's for</h3>
      <p>
        Anyone at Dartmouth. This isn't a computer science thing: you don't need a particular major,
        and you don't need to have read anything yet. The reading group asks for about 1h45 a week
        for [X] weeks. Everything else is drop-in.
      </p>
    </div>
    <div>
      <h3>Why this matters</h3>
      <p>
        AI systems are improving faster than our understanding of them, and the decisions that shape
        how this goes are being made now. Students can do real work here. <a href="/mission/">Read our mission&nbsp;→</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Start here</h2>
      <span>Three things to read before anything else</span>
    </div>
    <div class="list">
      {startHere.map((item) => <ResourceRow item={item} />)}
    </div>
    <a href="/resources/" style="font-size: 16.5px;">All resources&nbsp;→</a>
  </section>
</Base>
