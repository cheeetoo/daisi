---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="Thanks">
  <section class="page-title">
    <h1>Thanks.</h1>
    <p class="lede">
      I'll be in touch within a few days. In the meantime, <a href={site.groupMeUrl}>join the GroupMe</a> if you haven't, which is where everything gets announced. If you'd like to talk it over first, <a href={site.bookingUrl}>book a time</a>.
    </p>
    <p class="note">Something to read while you wait: <a href="/#start-here">start here</a>.</p>
  </section>
</Base>
